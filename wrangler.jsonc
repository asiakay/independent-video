{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "independent-video",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "independent-video",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
