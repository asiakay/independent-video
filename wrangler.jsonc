{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "independent-video",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "independent-video",
      "database_id": "a15c1a79-9b97-4b1f-ae45-e1899b3104a2",
      "migrations_dir": "./database/migrations"
    }
  ],
  "assets": {
    "directory": "./apps/studio",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  }
}
