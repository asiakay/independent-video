{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": "."
  },
  "include": [
    "modules/**/*.ts",
    "packages/**/*.ts",
    "worker/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx"
  ]
}
